HOST=127.0.0.1
PORT=8796
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_REALTIME_MODEL=gpt-realtime-2
# Keep this server-to-server token out of browser code.
SERVER_TOKEN=
ALLOWED_ORIGINS=http://localhost:8796,http://127.0.0.1:8796
REQUESTS_PER_MINUTE=60
MAX_CONCURRENT=4
VOICE_SESSION_SECONDS=600
# Optional authenticated example:
ASSISTANT_URL=http://127.0.0.1:8796
GATEWAY_PORT=4188
DEMO_LOGIN_PASSWORD=
COOKIE_SECURE=0
